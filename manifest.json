{
  "manifest_version": 3,
  "name": "Snipwise - Screenshot & PDF",
  "version": "1.0.1",
  "version": "1.0.1",
  "description": "Screenshot any page - visible area, full page, or crop. Annotate, then save as PNG or PDF. 100% local, no uploads.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "editor.html",
        "pdf.html",
        "pdf.js",
        "jspdf.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}